(require :asdf)
(push (uiop:pathname-directory-pathname *load-truename*) asdf:*central-registry*)
(asdf:load-asd (merge-pathnames "trivia.asd" *load-truename*))
(asdf:load-system :trivia)
(assert (= 7 (trivia:match '(2 5) ((list a b) (+ a b)) (_ 0))))
(assert (equal '(2 3) (trivia:match '(1 2 3) ((cons 1 rest) rest) (_ nil))))
(assert (eq :no (trivia:match '(1 2) ((list 4 _) :yes) (_ :no))))
(assert (= 12 (trivia:match #(3 4) ((vector a b) (* a b)) (_ 0))))
(format t "TRIVIA-EGCL-PASS~%")
